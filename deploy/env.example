# /etc/cups-policy-gateway/env   (root:cupspl, mode 0640 -- it holds secrets)
# Every setting is CUPSPL_<NAME>; see app/config.py for the full list.

# --- listener -------------------------------------------------------------
CUPSPL_HOST=0.0.0.0
CUPSPL_PORT=631
CUPSPL_TLS_CERTFILE=/etc/cups-policy-gateway/tls/fullchain.pem
CUPSPL_TLS_KEYFILE=/etc/cups-policy-gateway/tls/privkey.pem

# --- CUPS backend (see docker/stack/cups/cupsd.conf) ---------------------------------
CUPSPL_CUPS_URL=unix:///run/cups/cups.sock

# --- storage --------------------------------------------------------------
# SQLite only: one file, no database server.
CUPSPL_DATABASE_URL=sqlite:////var/lib/cups-policy-gateway/gateway.db

# --- authentication (RADIUS) ----------------------------------------------
CUPSPL_RADIUS_HOST=192.0.2.10
CUPSPL_RADIUS_PORT=1812
CUPSPL_RADIUS_SECRET=change-me
CUPSPL_RADIUS_TIMEOUT=5
# successful logins are cached this long, so changes/disabling in RADIUS apply within this window
CUPSPL_AUTH_CACHE_SECONDS=60
# users unknown to the gateway are created at first login in this group (false = admins pre-register users)
CUPSPL_AUTO_CREATE_USERS=true
CUPSPL_DEFAULT_GROUP=default

# --- admin portal ---------------------------------------------------------
# signs session cookies; generated by install.sh. Rotating it logs every admin out.
CUPSPL_SECRET_KEY=__GENERATED__

# --- misc -----------------------------------------------------------------
# time zone of quota periods and of the times shown; CHANGE it to yours (for example Europe/Rome)
CUPSPL_TIMEZONE=UTC
# language of the portal for visitors whose browser does not say (and for users who did not pick one): en it es ru zh
CUPSPL_LANGUAGE=en
CUPSPL_RECONCILE_INTERVAL=30
CUPSPL_LOG_LEVEL=INFO

# --- accounts (added with the personal print keys) -----------------------------
# RADIUS is optional: leave CUPSPL_RADIUS_HOST / CUPSPL_RADIUS_SECRET empty for local accounts only.
# keys = clients print with a personal key made in the portal (recommended); keys+radius = also the RADIUS password.
CUPSPL_IPP_AUTH=keys
CUPSPL_KEY_TTL_DAYS_RADIUS=90
CUPSPL_KEY_TTL_DAYS_LOCAL=365
# first-run administrator: the one-time code is printed in the service log (journalctl -u cups-policy-gateway | grep "FIRST RUN")
CUPSPL_BOOTSTRAP_ADMIN=true
CUPSPL_BOOTSTRAP_ADMIN_USERNAME=cups_orchestrator
# audit archive: compressed files, kept forever, in this folder (must be writable by the service user)
CUPSPL_AUDIT_MAX_MB=50
CUPSPL_AUDIT_ARCHIVE_DIR=/var/lib/cups-policy-gateway/audit-archive
